# Copie este arquivo para .env e preencha com as suas chaves reais.
# O arquivo .env está no .gitignore e NUNCA deve ser commitado.
#
# As credenciais abaixo são do projeto e-Pet (Firebase Console → Configurações do projeto).
# IMPORTANTE: o app falha com erro explícito se alguma destas variáveis estiver ausente.
# Em produção, configure as mesmas variáveis EXPO_PUBLIC_* nas envs do EAS Build.

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
